NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# The PRODUCTION Atlas cluster — a different connection string from apps/api/.env's dev cluster,
# never the same database. The deploy host's egress IP must be added to this Atlas project's
# Network Access allowlist before the container can connect; see docs/manual_deploy.md.
MONGO_URI=mongodb+srv://<user>:<password>@<prod-cluster>.mongodb.net/greynote?retryWrites=true&w=majority

# The admin portal's real origin once apps/web is deployed (docs/roadmap.md phase 9) — e.g.
# https://admin.greynote.example. The example ships http://localhost:3000, which blocks every
# request from a real deployed panel the moment it exists.
CORS_ORIGINS=http://localhost:3000

# Token signing secrets — SEPARATE by design (docs/decision-log.md): a leaked access-token secret
# must not also forge refresh tokens. Generate PRODUCTION values, never reuse the dev ones:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

BCRYPT_COST_FACTOR=12

# Backs Identity's document-upload endpoint (POST /api/identity/users/:id/documents). Optional —
# only actually required the moment that endpoint is called.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# No BOOTSTRAP_ADMIN_* vars — after the stack is up, run the seed script once inside the running
# container instead (see docs/manual_deploy.md):
#   docker compose -f docker-compose.prod.yml exec api node dist/scripts/seed.js
