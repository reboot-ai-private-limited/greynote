NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# The PRODUCTION Atlas cluster — a different connection string from apps/api/.env's dev cluster,
# never the same database. The deploy host's egress IP must be added to this Atlas project's
# Network Access allowlist before the container can connect; see docs/manual_deploy.md.
MONGO_URI=mongodb+srv://<user>:<password>@<prod-cluster>.mongodb.net/greynote?retryWrites=true&w=majority

# The admin portal's real origin once apps/web is deployed (docs/roadmap.md phase 9) — e.g.
# https://admin.greynote.example. The example ships http://localhost:3000, which blocks every
# request from a real deployed panel the moment it exists.
# Also list the company website's origin (comma-separated, no trailing slash) — its public account-deletion
# form calls POST /api/identity/auth/delete-account-public from the browser:
#   CORS_ORIGINS=https://admin.greynote.example,https://www.greynotehealth.com
CORS_ORIGINS=http://localhost:3001

# Token signing secrets — SEPARATE by design (docs/decision-log.md): a leaked access-token secret
# must not also forge refresh tokens. Generate PRODUCTION values, never reuse the dev ones:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

BCRYPT_COST_FACTOR=12

# Backs Identity's document-upload endpoint (POST /api/identity/users/:id/documents). Optional —
# only actually required the moment that endpoint is called.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# No BOOTSTRAP_ADMIN_* vars — after the stack is up, run the seed script once inside the running
# container instead (see docs/manual_deploy.md):
#   docker compose -f docker-compose.prod.yml exec api node dist/scripts/seed.js

# Place search for doctor / chemist / distributor locations (Places API (New)) — enable it on the key's
# Google Cloud project. Optional at boot: without it, place search returns 503. Routes no longer use
# Google: their km is typed (decision-log 2026-10-14).
GOOGLE_MAPS_API_KEY=

# Push notifications (Firebase Cloud Messaging). Paste the service-account JSON from Firebase Console >
# Project settings > Service accounts, on ONE line. Optional: unset means no push, Inbox still works.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Outgoing mail for the Admin forgot-password code (Gmail SMTP). Use a Google App password (account needs 2-step
# verification), never the account password. Optional: unset means no code can be emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Where the code is sent (the owner's address; whoever reads it can take over any Admin account) and the most codes sent in
# any 24 hours for all Admins together. No owner email = admin self-service reset is off.
PASSWORD_RESET_OWNER_EMAIL=
PASSWORD_RESET_DAILY_LIMIT=3
