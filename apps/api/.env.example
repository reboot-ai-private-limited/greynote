NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# MongoDB is Atlas-hosted in every environment, including local development — there is no
# docker-compose Mongo service to start first. Ask a teammate for the dev cluster's connection
# string, or create your own free-tier Atlas cluster for local work; either way this is an SRV
# string, not a bare mongodb:// host:port. See docs/decision-log.md, 2026-09-23.
#
# Required as of the `identity` module (docs/roadmap.md phase 1) — the first Mongoose-backed module.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/greynote-dev?retryWrites=true&w=majority

# Comma-separated browser origins the API accepts credentialed requests from. apps/web (Next.js)
# runs on :3001 locally so it doesn't collide with this API's own PORT above.
CORS_ORIGINS=http://localhost:3001

# Token signing secrets — SEPARATE by design, matching driverzone's reasoning (docs/decision-log.md
# there, 2026-08-24): a leaked access-token secret must not also forge refresh tokens.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# bcrypt cost factor. See docs/decision-log.md — bcrypt chosen over argon2/bcryptjs, and its
# 72-byte password-length limit is enforced (not truncated) at the DTO layer.
BCRYPT_COST_FACTOR=12

# No BOOTSTRAP_ADMIN_* vars here — a plaintext admin password shouldn't sit in .env indefinitely
# (docs/decision-log.md). Once MONGO_URI above is set, run `pnpm --filter @greynote/api seed`
# instead: it seeds SystemConfig/Role defaults and interactively prompts for the first Admin's
# details (masked password entry) only if none exists yet. Safe to re-run anytime.

# Backs Identity's document-upload endpoint (POST /api/identity/users/:id/documents). Optional at
# boot — every other route works fine without it — and only actually required the moment that
# endpoint is called.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Place search for doctor / chemist / distributor locations (Places API (New)) — enable it on the key's
# Google Cloud project. Optional at boot: without it, place search returns 503. Routes no longer use
# Google: their km is typed (decision-log 2026-10-14).
GOOGLE_MAPS_API_KEY=

# Push notifications (Firebase Cloud Messaging). Paste the service-account JSON from Firebase Console >
# Project settings > Service accounts, on ONE line. Optional: unset means no push, Inbox still works.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Outgoing mail for the Admin forgot-password code (Gmail SMTP). Use a Google App password (account needs 2-step
# verification), never the account password. Optional: unset means no code can be emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Where the code is sent (the owner's address; whoever reads it can take over any Admin account) and the most codes sent in
# any 24 hours for all Admins together. No owner email = admin self-service reset is off.
PASSWORD_RESET_OWNER_EMAIL=
PASSWORD_RESET_DAILY_LIMIT=3
