NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# MongoDB is Atlas-hosted in every environment, including local development — there is no
# docker-compose Mongo service to start first. Ask a teammate for the dev cluster's connection
# string, or create your own free-tier Atlas cluster for local work; either way this is an SRV
# string, not a bare mongodb:// host:port. See docs/decision-log.md, 2026-09-23.
#
# MONGO_URI is currently OPTIONAL (apps/api/src/config/env.ts) because no module connects to
# Mongo yet — the health module's probe is in-memory. It becomes required the moment the first
# Mongoose-backed module (Identity, docs/roadmap.md phase 1) lands; that's a one-line change in
# env.ts, not a reason to leave this unset now.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/greynote-dev?retryWrites=true&w=majority

# Comma-separated browser origins the API accepts credentialed requests from. Once apps/web
# (Next.js) is scaffolded it will need a port that doesn't collide with this API's own PORT above
# — likely :3001 locally — update this list then.
CORS_ORIGINS=http://localhost:3000

# ── Not read yet — placeholders for docs/roadmap.md phase 1 (Identity & Auth) ─────────────────
# Uncomment and wire into env.ts's schema when that phase starts. Listed here now so the shape of
# a complete .env is visible in one place, the same way driverzone's example file documents keys
# ahead of the module that reads them.

# Token signing secrets — SEPARATE by design, matching driverzone's reasoning (docs/decision-log.md
# there, 2026-08-24): a leaked access-token secret must not also forge refresh tokens.
#   openssl rand -base64 48
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Login is employee_code + password (hld/04-authentication-and-sessions.md §"POST /auth/login"),
# not OTP — bcrypt/argon2 needs no server-held secret beyond the per-user salt it stores itself,
# so there is no pepper-style env var here the way an OTP-based login would need.
