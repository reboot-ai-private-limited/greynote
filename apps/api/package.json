{
    "name": "@greynote/api",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "clean": "rm -rf dist",
        "build": "pnpm clean && tsc --noEmit && node esbuild.config.mjs",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src && pnpm lint:deps",
        "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
        "test": "vitest run"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.4",
        "@greynote/contracts": "workspace:*",
        "bcrypt": "^5.1.1",
        "cloudinary": "^2.5.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.9.5",
        "multer": "^1.4.5-lts.1",
        "pino": "^9.6.0",
        "pino-http": "^10.4.0",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.0.5",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@greynote/config": "workspace:*",
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.12",
        "@types/swagger-ui-express": "^4.1.8",
        "dependency-cruiser": "^16.9.0",
        "esbuild": "^0.24.2",
        "pino-pretty": "^13.0.0",
        "tsx": "^4.23.14",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
    }
}
