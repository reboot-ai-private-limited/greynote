{
    "name": "@greynote/api",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "clean": "rm -rf dist",
        "build": "pnpm clean && tsc --noEmit && node esbuild.config.mjs",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src && pnpm lint:deps",
        "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
        "test": "vitest run",
        "seed": "tsx src/scripts/seed.ts",
        "migrate:money": "tsx src/scripts/migrate-money-to-paise.ts",
        "migrate:territory": "tsx src/scripts/migrate-territory-flatten.ts",
        "migrate:route-km": "tsx src/scripts/migrate-route-km.ts",
        "migrate:profile-territory": "tsx src/scripts/migrate-profile-territory.ts",
        "migrate:territory-zones": "tsx src/scripts/migrate-territory-zones.ts",
        "migrate:payband-ctc": "tsx src/scripts/migrate-payband-salary-to-ctc.ts",
        "migrate:paybands": "tsx src/scripts/migrate-paybands.ts",
        "seed:sample-sales": "tsx src/scripts/seed-sample-sales.ts",
        "seed:demo-manager": "tsx src/scripts/seed-demo-manager.ts",
        "seed:demo-hierarchy": "tsx src/scripts/seed-demo-hierarchy.ts",
        "seed:demo-plans": "tsx src/scripts/seed-demo-plans.ts",
        "export:pay-bands": "tsx src/scripts/export-pay-bands.ts",
        "seed:production": "tsx src/scripts/seed-production.ts",
        "migrate:employee-codes": "tsx src/scripts/migrate-employee-codes.ts",
        "migrate:admin-codes": "tsx src/scripts/migrate-admin-codes.ts",
        "migrate:specialties": "tsx src/scripts/migrate-specialties.ts",
    "migrate:doctor-visits": "tsx src/scripts/migrate-doctor-visits.ts",
        "migrate:distributors": "tsx src/scripts/migrate-distributors.ts",
        "migrate:mrp-orders": "tsx src/scripts/migrate-mrp-orders.ts",
        "migrate:targets": "tsx src/scripts/migrate-targets-to-ranges.ts",
        "report:manager-targets": "tsx src/scripts/report-manager-targets.ts",
        "migrate:expense-months": "tsx src/scripts/migrate-expense-month-approval.ts",
        "migrate:expense-finalized": "tsx src/scripts/migrate-expense-finalized.ts",
        "migrate:ctc-statutory": "tsx src/scripts/migrate-ctc-statutory.ts",
        "migrate:inherit-monthly": "tsx src/scripts/migrate-inherit-monthly-plans.ts",
        "migrate:drop-plan-changes": "tsx src/scripts/migrate-drop-daily-plan-changes.ts",
        "migrate:single-approval": "tsx src/scripts/migrate-single-approval.ts",
        "compliance:run": "tsx src/scripts/run-compliance.ts",
        "stock-check:run": "tsx src/scripts/run-stock-check.ts"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.4",
        "@greynote/contracts": "workspace:*",
        "bcrypt": "^5.1.1",
        "cloudinary": "^2.5.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.0",
        "express-rate-limit": "^8.7.1",
        "firebase-admin": "^14.5.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.9.5",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^10.1.1",
        "pino": "^9.6.0",
        "pino-http": "^10.4.0",
        "prompts": "^2.4.2",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.0.5",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@greynote/config": "workspace:*",
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.12",
        "@types/nodemailer": "^8.0.2",
        "@types/prompts": "^2.4.9",
        "@types/swagger-ui-express": "^4.1.8",
        "dependency-cruiser": "^16.9.0",
        "esbuild": "^0.24.2",
        "pino-pretty": "^13.0.0",
        "tsx": "^4.23.14",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
