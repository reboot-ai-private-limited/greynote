# Inlined into the browser bundle at BUILD time — changing it needs a rebuild.
# The API runs on :3000; this app runs on :3001 (add that origin to the API's CORS_ORIGINS).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# OPTIONAL. A BROWSER key for the route stops map (Maps JavaScript API). It ships to every browser, so
# restrict it in Google Cloud: HTTP referrers = the portal's domain, API = "Maps JavaScript API" only.
# This is NOT the API's own server-side Google key (Places + Routes) and must never be the same one.
# Empty is fine: the map shows "preview unavailable" and everything else works.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
