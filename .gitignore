# Dependency directories
node_modules/
    
# Build outputs
dist/
build/
.next/
    
# Turborepo caching
.turbo/
    
# Environment variables
.env
.env.*
!.env.example
!**/.env.*.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS generated files
.DS_Store
Thumbs.db

# TypeScript incremental build cache
*.tsbuildinfo

# Firebase service-account keys: secrets, never commit (the server reads FIREBASE_SERVICE_ACCOUNT_JSON from .env.prod)
*-firebase-adminsdk-*.json
